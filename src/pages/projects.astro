---
import Overlay from "../components/Overlay.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Overlay>
    <h2 class="text-2xl text-center font-bold">Projects:</h2>
    <div class="flex flex-col gap-4 mt-4 items-center">
      <div class="flex flex-row gap-6 items-center">
        <a
          href="https://gointospace.app"
          class="text-rosepine-iris hover:text-rosepine-love font-bold text-lg flex items-center gap-1"
        >
          <img class="w-7 h-7" src="/res/projects/space.png" alt="Space icon" />
          Space
        </a><p class="text-rosepine-subtle">Web Proxy</p>
      </div>
      <div class="flex flex-row gap-6 items-center">
        <a
          href="https://daydreamx.pro"
          class="text-rosepine-iris hover:text-rosepine-love font-bold text-lg flex items-center gap-1"
        >
          <img class="w-7 h-7" src="/res/projects/ddx.png" alt="DDX icon" />
          DayDream X
        </a><p class="text-rosepine-subtle">Web Proxy</p>
      </div>
      <div class="flex flex-row gap-6 items-center">
        <a
          href=""
          class="text-rosepine-iris hover:text-rosepine-love font-bold text-lg flex items-center gap-1"
        >
          <img class="w-7 h-7" src="/res/projects/umbra.png" alt="Umbra icon" />
          Umbra
        </a><p class="text-rosepine-subtle">Music Player</p>
      </div>
      <p class="text-rosepine-muted text-sm">That's all of the public ones for now!</p>
    </div>
    <br>
    <h2 class="text-2xl font-semibold mb-4 text-center">Stuff I'm using or learning:</h2>
    <div class="flex flex-row gap-4">
    </div>
  </Overlay>

  <script>
    import { createIcons, icons } from "lucide";

    createIcons({ icons });

    document.addEventListener("astro:page-load", () => {
      createIcons({ icons });
    });
    document.addEventListener("astro:after-swap", () => {
      createIcons({ icons });
    });
  </script>
</Layout>
