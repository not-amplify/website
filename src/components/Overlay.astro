---
export interface Props {
  enableBg?: boolean;
  customClasses?: string;
}

const { enableBg = true, customClasses = "" } = Astro.props;

const bgClass = enableBg ? "bg-rosepine-surface backdrop-blur-md border border-rosepine-highlightLow shadow-lg" : "";
---

<div
    class={`text-rosepine-text rounded-xl p-6 ${bgClass} ${customClasses}`}
  >
  <slot />
</div>