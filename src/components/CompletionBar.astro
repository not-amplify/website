---
export interface Props {
  language: string;
  percentage: number;
  color?: string;
}

const { language, percentage, color = "bg-rosepine-iris" } = Astro.props;
---

<div class="flex items-center gap-3 mb-3">
  <div class="flex items-center gap-2 min-w-0 flex-1">
    <div class=`w-2 h-2 rounded-full ${color}`></div>
    <span class="text-rosepine-text text-sm truncate">{language}</span>
  </div>
  <div class="flex items-center gap-2 min-w-0">
    <div class="w-20 h-2 bg-rosepine-highlightLow rounded-full overflow-hidden">
      <div 
        class=`h-full ${color} transition-all duration-500 ease-out`
        style={`width: ${percentage}%`}
      ></div>
    </div>
    <span class="text-xs text-rosepine-muted w-8 text-right">{percentage}%</span>
  </div>
</div>