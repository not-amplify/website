---
import Background from "../components/Background.astro";
import Nav from "../components/Nav.astro";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/res/me.jpg" />
    <title>Portfolio ig</title>
    <ClientRouter transition:animate="fade" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-04V8QYEC92"
    ></script>
    <script>
      //@ts-ignore
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        //@ts-ignore
        dataLayer.push(arguments);
      }
    //@ts-ignore  
      gtag("js", new Date());
      //@ts-ignore
      gtag("config", "G-04V8QYEC92");
    </script>
  </head>
  <body
    class="overflow-hidden w-screen h-screen m-0 bg-rosepine-base text-rosepine-text"
  >
    <Background />
    <Nav />
    <div
      class="flex items-center justify-center overflow-hidden w-screen h-screen m-0"
    >
      <slot />
    </div>
    <script>
      import { createIcons, icons } from "lucide";

      createIcons({ icons });

      document.addEventListener("astro:page-load", () => {
        createIcons({ icons });
      });
      document.addEventListener("astro:after-swap", () => {
        createIcons({ icons });
      });
    </script>
  </body>
</html>
